{
  "name": "x-desktop",
  "version": "1.0.0",
  "description": "Native macOS wrapper for X (x.com)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.xdesktop",
    "productName": "Xorcist",
    "files": [
      "main.js",
      "splash.html",
      "build-assets/icon-512.png",
      "build-assets/icon.icns",
      "build-assets/icon.ico"
    ],
    "win": {
      "icon": "build-assets/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build-assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "X needs camera access for video calls and to record photos and video for posts.",
        "NSMicrophoneUsageDescription": "X needs microphone access for voice/video calls, Spaces, and recording audio and video for posts.",
        "NSMicrophoneUsageDescriptionMac": "X needs microphone access for voice/video calls, Spaces, and recording audio and video for posts.",
        "LSMinimumSystemVersion": "11.0"
      }
    }
  }
}
